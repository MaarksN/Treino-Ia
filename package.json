{
  "name": "treino-ia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "clean": "rm -rf dist",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"api/**/*.ts\" \"scripts/**/*.{js,mjs}\" \"*.{js,ts,mjs}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "test": "vitest run --maxWorkers 4 --reporter=dot",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e": "npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "coverage": "npm run test:coverage",
    "schema:drift": "vitest run tests/schemaDrift.test.ts",
    "smoke:supabase:social": "node tests/social-real-smoke.mjs",
    "preflight:sprint3": "node scripts/preflight-sprint3-env.mjs",
    "smoke:sprint3": "node scripts/smoke-sprint3-integrations.mjs",
    "smoke:tenant-ab": "node scripts/smoke-tenant-ab-isolation.mjs",
    "smoke:compliance": "node scripts/smoke-compliance-real.mjs",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "analyze": "vite build --mode analyze",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@sentry/react": "^10.53.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.10",
    "@upstash/redis": "^1.38.0",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.2.3",
    "lucide-react": "^1.17.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "stripe": "^22.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
