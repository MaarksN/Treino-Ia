# Public client env. Only VITE_* values can be exposed to the browser bundle.
VITE_ENV="development"
VITE_FEATURE_AUDIENCE="user"
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_ANON_KEY"
VITE_GEMINI_PROXY_URL="/api/gemini-proxy"
VITE_SENTRY_DSN=""
VITE_SENTRY_RELEASE=""
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"

# Server-side app origin and CORS allowlist. Never use '*' in production.
APP_URL="https://staging.treinoia.example"
CORS_ALLOWED_ORIGINS="https://staging.treinoia.example"
API_ALLOWED_ORIGINS=""
TELEMETRY_ALLOWED_ORIGINS="https://staging.treinoia.example"
OAUTH_REDIRECT_ALLOWED_ORIGINS="https://staging.treinoia.example"

# Supabase server-side APIs. Never expose the service role key to the browser.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY"

# Supabase CLI migrations. Keep these outside the frontend bundle.
# Use either SUPABASE_ACCESS_TOKEN with a linked project, or SUPABASE_DB_URL for direct db push/list commands.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_DB_URL=""
SOCIAL_SMOKE_EMAIL_DOMAIN="example.com"

# Billing / Stripe server-side APIs.
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_YEARLY="price_xxx"
STRIPE_PRICE_COACH_MONTHLY="price_xxx"
STRIPE_PRICE_COACH_YEARLY="price_xxx"
STRIPE_PRICE_ELITE_MONTHLY="price_xxx"
STRIPE_PRICE_ELITE_YEARLY="price_xxx"

# Gemini server-side proxy. Never expose GEMINI_API_KEY as VITE_*.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Distributed rate limit (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Retention worker / notifications. RETENTION_WORKER_SECRET can mirror Vercel CRON_SECRET.
RETENTION_WORKER_SECRET="change_me"
CRON_SECRET="change_me"
RETENTION_NOTIFICATION_WEBHOOK_URL=""
RETENTION_NOTIFICATION_WEBHOOK_SECRET=""

# Health OAuth connectors. Secrets are server-side only.
GOOGLE_FIT_CLIENT_ID=""
GOOGLE_FIT_CLIENT_SECRET=""
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
HEALTH_OAUTH_TOKEN_ENCRYPTION_KEY=""
OAUTH_TOKEN_SECURITY_MODE="plaintext_blocked"

# CI/CD secrets configured in GitHub/Vercel/Sentry, not committed in real .env files.
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="treino-ia"
SENTRY_RELEASE=""
SENTRY_DEPLOY_ENV="staging"
LHCI_GITHUB_APP_TOKEN=""

# Sprint 3 smoke scripts. Use only in local secure shells/CI, never in browser env.
STAGING_APP_URL="https://staging.treinoia.example"
SUPABASE_TEST_ACCESS_TOKEN=""
STRIPE_SMOKE_PLAN_ID="pro"
STRIPE_SMOKE_INTERVAL="month"
GEMINI_SMOKE_EXPECT_SUCCESS="false"
